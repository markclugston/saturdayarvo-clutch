{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prepare-api",
      "dependsOrder": "sequence",
      "dependsOn": ["build-api", "migrate-api"],
      "problemMatcher": []
    },
    {
      "label": "build-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Clutch.API/Clutch.API.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "migrate-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "ef",
        "database",
        "update",
        "--project",
        "${workspaceFolder}/src/Clutch.API/Clutch.API.csproj",
        "--no-build"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "problemMatcher": []
    }
  ]
}
