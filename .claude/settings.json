{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(/**)",
      "Edit(/**)",
      "PowerShell(dotnet new *)",
      "Bash(dotnet new *)",
      "PowerShell(dotnet sln *)",
      "Bash(dotnet sln *)",
      "PowerShell(dotnet add *)",
      "Bash(dotnet add *)",
      "PowerShell(dotnet restore *)",
      "Bash(dotnet restore *)",
      "PowerShell(dotnet build *)",
      "Bash(dotnet build *)",
      "PowerShell(dotnet test *)",
      "Bash(dotnet test *)",
      "PowerShell(dotnet ef *)",
      "Bash(dotnet ef *)",
      "PowerShell(dotnet list *)",
      "Bash(dotnet list *)",
      "PowerShell(dotnet run *)",
      "Bash(dotnet run *)",
      "PowerShell(npm audit *)",
      "Bash(npm audit *)",
      "PowerShell(npm test *)",
      "Bash(npm test *)",
      "PowerShell(npm run test *)",
      "Bash(npm run test *)",
      "PowerShell(npm run test:e2e *)",
      "Bash(npm run test:e2e *)",
      "PowerShell(npm run test:e2e:integration *)",
      "Bash(npm run test:e2e:integration *)",
      "PowerShell(npm run lint *)",
      "Bash(npm run lint *)",
      "PowerShell(npm run build *)",
      "Bash(npm run build *)",
      "PowerShell(npm run typecheck *)",
      "Bash(npm run typecheck *)",
      "PowerShell(npm --prefix src/clutch-web *)",
      "Bash(npm --prefix src/clutch-web *)",
      "PowerShell(npm --prefix 'src\\clutch-web' *)",
      "Bash(npm --prefix 'src\\clutch-web' *)",
      "PowerShell(npm --prefix .\\src\\clutch-web *)",
      "Bash(npm --prefix .\\src\\clutch-web *)",
      "PowerShell(npx eslint *)",
      "Bash(npx eslint *)",
      "PowerShell(.\\.specify\\scripts\\powershell\\check-prerequisites.ps1 *)",
      "PowerShell(.\\.specify\\scripts\\powershell\\setup-plan.ps1 *)",
      "PowerShell(.\\.specify\\scripts\\powershell\\create-new-feature.ps1 *)",
      "PowerShell(.\\.specify\\scripts\\powershell\\setup-tasks.ps1 *)",
      "PowerShell(Test-Path 'node_modules')"
    ]
  }
}
